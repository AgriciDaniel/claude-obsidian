{
  "schema_version": 1,
  "product": {
    "id": "claude-obsidian",
    "name": "claude-obsidian",
    "promise": "Build and maintain a local-first, source-cited, compounding Obsidian knowledge base through portable Agent Skills.",
    "non_promises": [
      "Automatic transcript capture",
      "Automatic remote-model or cloud enrichment",
      "Destructive repair without explicit approval",
      "Guaranteed factual correctness without supporting evidence",
      "Public publishing, pushing, tagging, or releasing without owner approval",
      "Replacement for backups, source control, or professional advice"
    ]
  },
  "supported_hosts": [
    {
      "id": "agent-skills-compatible",
      "support_level": "compatible",
      "implementation_paths": [
        "AGENTS.md",
        "skills"
      ]
    },
    {
      "id": "claude-code",
      "support_level": "native",
      "implementation_paths": [
        ".claude-plugin/plugin.json",
        "hooks/hooks.json",
        "skills"
      ]
    },
    {
      "id": "codex-cli",
      "support_level": "compatible",
      "implementation_paths": [
        "AGENTS.md",
        "skills"
      ]
    },
    {
      "id": "cursor",
      "support_level": "compatible",
      "implementation_paths": [
        "scripts/setup-multi-agent.sh",
        "skills"
      ]
    },
    {
      "id": "gemini-cli",
      "support_level": "compatible",
      "implementation_paths": [
        "scripts/setup-multi-agent.sh",
        "skills"
      ]
    },
    {
      "id": "opencode",
      "support_level": "compatible",
      "implementation_paths": [
        "AGENTS.md",
        "skills"
      ]
    },
    {
      "id": "windsurf",
      "support_level": "compatible",
      "implementation_paths": [
        "scripts/setup-multi-agent.sh",
        "skills"
      ]
    }
  ],
  "installation_modes": [
    {
      "id": "agent-skills-link",
      "host": "agent-skills-compatible",
      "implementation_paths": [
        "scripts/setup-multi-agent.sh",
        "skills"
      ]
    },
    {
      "id": "claude-local-plugin",
      "host": "claude-code",
      "implementation_paths": [
        ".claude-plugin/plugin.json",
        "skills"
      ]
    },
    {
      "id": "claude-marketplace",
      "host": "claude-code",
      "implementation_paths": [
        ".claude-plugin/plugin.json",
        "claude_obsidian/release.py",
        "config/public-marketplace.json",
        "config/release-allowlist.json"
      ]
    },
    {
      "id": "codex-skills-link",
      "host": "codex-cli",
      "implementation_paths": [
        "scripts/setup-multi-agent.sh",
        "skills"
      ]
    },
    {
      "id": "cursor-workspace-skills-link",
      "host": "cursor",
      "implementation_paths": [
        "scripts/setup-multi-agent.sh",
        "skills"
      ]
    },
    {
      "id": "gemini-skills-link",
      "host": "gemini-cli",
      "implementation_paths": [
        "scripts/setup-multi-agent.sh",
        "skills"
      ]
    },
    {
      "id": "opencode-skills-link",
      "host": "opencode",
      "implementation_paths": [
        "scripts/setup-multi-agent.sh",
        "skills"
      ]
    },
    {
      "id": "windsurf-workspace-skills-link",
      "host": "windsurf",
      "implementation_paths": [
        "scripts/setup-multi-agent.sh",
        "skills"
      ]
    }
  ],
  "privacy_defaults": {
    "local_first": true,
    "telemetry": "disabled",
    "remote_egress": "explicit_consent",
    "session_context_injection": "explicit_environment_opt_in",
    "automatic_recovery_warning": "aggregate_status_only",
    "transcript_capture": "disabled",
    "source_payloads": "create_only_immutable",
    "destructive_repairs": "explicit_consent"
  },
  "compatibility": {
    "minimum_python": "3.11",
    "vault_layout": "v1",
    "legacy_scripts": "supported_through_v1",
    "migration": "explicit_dry_run_first",
    "filesystem_fallback": true,
    "new_configuration_optional": true
  },
  "release_gates": [
    {
      "id": "artifact-safety",
      "required": true,
      "verification": {
        "type": "command",
        "command": [
          "{python}",
          "tests/test_release.py"
        ]
      }
    },
    {
      "id": "capability-verification",
      "required": true,
      "verification": {
        "type": "command",
        "command": [
          "{python}",
          "claude_obsidian/contracts.py",
          "--repo-root",
          ".",
          "--verify"
        ]
      }
    },
    {
      "id": "clean-hermetic-suite",
      "required": true,
      "verification": {
        "type": "command",
        "command": [
          "make",
          "test"
        ]
      }
    },
    {
      "id": "deterministic-sample",
      "required": true,
      "verification": {
        "type": "command",
        "command": [
          "{python}",
          "tests/test_distribution_vaults.py"
        ]
      }
    },
    {
      "id": "core-workflow-forward-tests",
      "required": true,
      "verification": {
        "type": "manual",
        "evidence": "Fresh-context Save, Ingest, and Query runs against the deterministic acceptance vault satisfy their skill invariants: selected content only, source fidelity and provenance, reviewed transaction scope, resolving citations or grounded refusal, and byte-for-byte read-only Query behavior. Record prompts, outputs, before/after hashes, host/model versions, and reviewer disposition."
      }
    },
    {
      "id": "evidence-review",
      "required": true,
      "verification": {
        "type": "manual",
        "evidence": "Release and comparison claims resolve through current evidence records; unsupported claims are removed or qualified."
      }
    },
    {
      "id": "fresh-context-review",
      "required": true,
      "verification": {
        "type": "manual",
        "evidence": "A read-only fresh-context verifier reports zero BLOCKER and zero HIGH findings at the candidate commit."
      }
    },
    {
      "id": "migration-and-uninstall",
      "required": true,
      "verification": {
        "type": "manual",
        "evidence": "Migration, rollback, and uninstall are verified from a clean environment and a representative legacy vault."
      }
    },
    {
      "id": "owner-promotion-approval",
      "required": true,
      "verification": {
        "type": "manual",
        "evidence": "The repository owner explicitly approves any public push, tag, issue mutation, or release."
      }
    },
    {
      "id": "transaction-recovery",
      "required": true,
      "verification": {
        "type": "command",
        "command": [
          "{python}",
          "tests/test_transaction.py"
        ]
      }
    }
  ]
}
