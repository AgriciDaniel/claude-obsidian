    "docs/audits/**",
    "docs/releases/**",
    "scripts/baseline-v16.py",
    "scripts/benchmark-runner.py",
    "tests/fixtures/release/adversarial/**",
    "wiki/hot.md",
    "wiki/log.md",
    "wiki/meta/**"
  ],
  "include_files": [
    ".gitattributes",
    ".gitignore",
    "AGENTS.md",
    "ATTRIBUTION.md",
    "CHANGELOG.md",
    "CITATION.cff",
    "CODEOWNERS",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "GEMINI.md",
    "LICENSE",
    "Makefile",
    "PRIVACY.md",
    "README.md",
    "SECURITY.md",
    "WIKI.md"
  ],
  "include_globs": [
    ".github/*.md",
    ".github/*.yml",
    ".github/ISSUE_TEMPLATE/*.md",
    ".github/workflows/*.yml"
  ],
  "include_roots": [
    ".claude-plugin",
    ".cursor",
    ".windsurf",
    "agents",
    "assets",
    "claude_obsidian",
    "config",
    "docs",
    "examples",
    "hooks",
    "scripts",
    "skills",
    "templates",
    "tests"
  ],
  "limits": {
    "max_archive_bytes": 104857600,
    "max_compression_ratio": 20,
    "max_file_bytes": 10485760,
    "max_files": 5000,
    "max_total_bytes": 52428800
  },
